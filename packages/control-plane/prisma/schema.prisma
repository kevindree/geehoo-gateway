// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// User / Auth
// =====================================================

enum SystemRole {
  SUPER_ADMIN
  USER
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
}

enum EmailTokenType {
  ACTIVATION
  PASSWORD_RESET
  INVITATION
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  status          UserStatus @default(PENDING_ACTIVATION)
  systemRole      SystemRole @default(USER)
  displayName     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  emailTokens     EmailToken[]
  sentInvitations Invitation[]      @relation("InvitationSender")
}

model EmailToken {
  id         String         @id @default(cuid())
  userId     String?
  type       EmailTokenType
  tokenHash  String         @unique
  expiresAt  DateTime
  consumedAt DateTime?
  metadata   Json?
  createdAt  DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// =====================================================
// Workspace (multi-tenant root)
// =====================================================

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  DELETING
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Workspace {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  status    WorkspaceStatus @default(ACTIVE)
  ownerId   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members     WorkspaceMember[]
  projects    Project[]
  invitations Invitation[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  invitedById String?
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Invitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole    @default(MEMBER)
  invitedById String
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User      @relation("InvitationSender", fields: [invitedById], references: [id])

  @@index([workspaceId, email])
}

// =====================================================
// Project (scoped to workspace)
// =====================================================

enum ProjectStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DELETING
  ERROR
}

enum UpstreamType {
  REST
  GRAPHQL
  WEBSOCKET
  SOAP
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

model Project {
  id            String        @id @default(cuid())
  workspaceId   String
  name          String
  slug          String
  status        ProjectStatus @default(PROVISIONING)
  k8sNamespace  String        @unique
  ingressPrefix String        @unique
  description   String?
  authRequired  Boolean       @default(true)
  params        Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  routes    Route[]
  upstreams Upstream[]
  apiKeys   ApiKey[]
  endUsers  EndUser[]

  @@unique([workspaceId, slug])
}

model Route {
  id          String     @id @default(cuid())
  projectId   String
  name        String
  path        String
  method      HttpMethod
  public      Boolean    @default(false)
  enabled     Boolean    @default(true)
  description String?

  authConfig        Json?
  rateLimitConfig   Json?
  orchestrationFlow Json

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path, method])
}

model Upstream {
  id          String       @id @default(cuid())
  projectId   String
  name        String
  type        UpstreamType @default(REST)
  baseUrl     String
  description String?

  defaultHeaders Json?
  timeout        Int   @default(10000)
  retryConfig    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model ApiKey {
  id           String    @id @default(cuid())
  projectId    String
  label        String
  keyHash      String    @unique
  keyPrefix    String
  keyEncrypted String?
  expiresAt    DateTime?
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model EndUser {
  id           String   @id @default(cuid())
  projectId    String
  email        String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
}
