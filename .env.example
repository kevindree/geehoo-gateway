# ===== Control Plane =====
DATABASE_URL="postgresql://api_gate:password@localhost:5432/api_gate"
REDIS_URL="redis://localhost:6379"
ADMIN_JWT_SECRET="change-me-must-be-at-least-32-characters-long"
GATEWAY_JWT_SECRET="change-me-must-be-at-least-32-characters-long"
INTERNAL_SERVICE_SECRET="change-me-min-16-chars"
KEY_ENCRYPTION_SECRET="change-me-must-be-at-least-32-characters-long"
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
APP_PUBLIC_URL="http://localhost:3000"

# Bootstrap super-admin (used by npm run db:seed, optional after first run)
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=changeme-strong-password

# ===== Kubernetes =====
K8S_ENABLED=false
GATEWAY_IMAGE="geehoo-gateway/gateway:latest"
# Set KUBECONFIG or in-cluster service account will be used
# KUBECONFIG=/path/to/kubeconfig

# ===== Gateway =====
GATEWAY_PROJECT_ID=""
GATEWAY_REDIS_URL="redis://localhost:6379"
GATEWAY_CONFIG_PATH="/etc/gateway/config.json"
# FQDN required when gateway runs in a different K8s namespace than control-plane
CONTROL_PLANE_INTERNAL_URL="http://control-plane:4000"
# Local dev only: path where control-plane writes config when K8S_ENABLED=false
LOCAL_GATEWAY_CONFIG_PATH="/gateway-config/config.json"

# ===== UI =====
VITE_API_URL="http://localhost:4000"

# ===== SMTP =====
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASS=change-me
SMTP_FROM="Geehoo Gateway <no-reply@example.com>"
