# ===== Control Plane =====
DATABASE_URL="postgresql://api_gate:password@localhost:5432/api_gate"
REDIS_URL="redis://localhost:6379"
ADMIN_JWT_SECRET="change-me-min-32-chars-admin-secret"
PORT=4000

# ===== Kubernetes =====
# Set KUBECONFIG or in-cluster service account will be used
# KUBECONFIG=/path/to/kubeconfig

# ===== Gateway (injected via K8s ConfigMap) =====
GATEWAY_PROJECT_ID=""
GATEWAY_JWT_SECRET="change-me-min-32-chars-gateway-secret"
GATEWAY_REDIS_URL="redis://localhost:6379"
GATEWAY_CONFIG_PATH="/etc/gateway/config.json"
PORT=3000

# ===== UI =====
VITE_API_URL="http://localhost:4000"
